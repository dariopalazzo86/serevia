rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Put the facilitator email addresses here, in lower case.
    function isFacilitator() {
      return request.auth != null
        && 'email' in request.auth.token
        && request.auth.token.email.lower() in [
          'facilitator@example.org'
        ];
    }

    // Clock and sent messages: everyone in the exercise reads, facilitators write.
    match /live/state {
      allow read: if request.auth != null;
      allow write: if isFacilitator();
    }

    // Message drafts, schedule and facilitator notes: facilitators only.
    match /fac/{docId} {
      allow read, write: if isFacilitator();
    }

    // Team name register: anyone can check whether one name is taken, nobody can
    // take over a name that exists, and only facilitators can list all names.
    match /teamNames/{nameKey} {
      allow get: if request.auth != null;
      allow list: if isFacilitator();
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40;
      allow delete: if request.auth != null
        && (resource.data.uid == request.auth.uid || isFacilitator());
    }

    // Each team reads and writes only its own answers; facilitators read and clear all.
    match /teams/{teamId} {
      allow read, write: if request.auth != null
        && (request.auth.uid == teamId || isFacilitator());
    }
  }
}
