rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Put the facilitator email addresses here, in lower case.
    function isFacilitator() {
      return request.auth != null
        && 'email' in request.auth.token
        && request.auth.token.email.lower() in [
          'facilitator@example.org'
        ];
    }

    // A team member is signed in with the login the facilitator created for that team.
    function isTeamMember(teamId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/roster/$(teamId))
        && get(/databases/$(database)/documents/roster/$(teamId)).data.uid == request.auth.uid;
    }

    // Clock and sent messages: everyone signed in reads, facilitators write.
    match /live/state {
      allow read: if request.auth != null;
      allow write: if isFacilitator();
    }

    // Message drafts, schedule, notes, team passwords and ratings: facilitators only.
    match /fac/{docId} {
      allow read, write: if isFacilitator();
    }

    // Team list: a team login can read only its own entry; facilitators manage all.
    match /roster/{teamId} {
      allow get: if request.auth != null && resource.data.uid == request.auth.uid;
      allow read, write: if isFacilitator();
    }

    // Answers: shared by all members of the team; facilitators read, reopen and clear.
    match /teams/{teamId} {
      allow read, write: if isFacilitator() || isTeamMember(teamId);
    }
  }
}
